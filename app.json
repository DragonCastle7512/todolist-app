{
  "expo": {
    "name": "Todo Checker",
    "slug": "TodoChecker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "todoapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dstle.todochecker"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-vector-icons/fontawesome-free-solid",
      "@react-native-vector-icons/lucide",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodoChecker",
              "label": "Todo Checker",
              "minWidth": "144dp",
              "minHeight": "144dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "description": "위젯으로 할 일을 추가하고 간편하게 관리하세요.",
              "previewImage": "./assets/images/icon.png"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "62495735-ff6e-4018-8dc1-4cc2e9878737"
      }
    },
    "owner": "kimys7512"
  }
}
